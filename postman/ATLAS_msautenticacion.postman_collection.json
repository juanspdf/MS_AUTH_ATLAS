    {
      "name": "3. Activacion / Recuperacion",
      "description": "Flujo de activacion de cuenta y recuperacion de contrasena via token.",
      "item": [
        {
          "name": "Validar Token de activacion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validar-token?token=INGRESAR_TOKEN_AQUI",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "validar-token"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "INGRESAR_TOKEN_AQUI"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Establecer contrasena (con token)",
